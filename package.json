{
  "name": "raftkv",
  "description": "A distributed key-value store built on a from-scratch Raft consensus implementation, with a live cluster dashboard.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/raft.test.ts",
    "cluster": "tsx src/cluster.ts",
    "node": "tsx src/server.ts",
    "cli": "tsx src/client.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
